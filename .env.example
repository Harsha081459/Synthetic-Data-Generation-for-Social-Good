# ===========================================
# SynthoGen AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#
# These keys are OPTIONAL — the dashboard works without them.
# They are only needed for the "Prompt-to-Patient" (AI) feature
# in the Live Generator tab.
# ===========================================

# Groq API key (for Llama 3.3 70B natural language parsing)
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# xAI API key (optional alternative LLM provider)
XAI_API_KEY=your_xai_api_key_here
